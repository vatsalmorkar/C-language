#include <iostream>

using namespace std;

class A {
public:
    void get(int a) {
        cout << "a: " << a << endl;
    }

    void get(int a, int b) {
        cout << "a & b: " << a << " or " << b << endl;
    }

    void get(int a, int b, int c) {
        cout << "Sum: " << a + b + c << endl;
    }
};

int main() {
    A obj; 
    obj.get(5);
    obj.get(3, 4);
    obj.get(1, 2, 3);
    return 0;
}
