#include <iostream>
using namespace std;

class Min {
public:
    void min(int a, int b) {
        if (a < b) {
            cout << "Minimum: " << a << endl;
        } else {
            cout << "Minimum: " << b << endl;
        }
    }
};

class Max {
public:
    void max(int a, int b) {
        if (a > b) {
            cout << "Maximum: " << a << endl;
        } else {
            cout << "Maximum: " << b << endl;
        }
    }
};

class MinMax : public Min, public Max {
};

int main() {
    MinMax obj;
    int x, y;

    cout << "Enter two numbers: ";
    cin >> x >> y;

    obj.min(x, y);
    obj.max(x, y);

    return 0;
}
