#include <iostream>
using namespace std;

class A {
public:
    double principal;
public:
    void get() {
        cout << "Enter Principal amount: ";
        cin >> principal;
    }
};

class Rate : public A {
public:
    double rate;
public:
    void hold() {
        cout << "Enter Rate of Interest (%): ";
        cin >> rate;
    }
};

class SimpleInterest : public Rate {
    double time, interest;
public:
    void Time() {
        cout << "Enter Time : ";
        cin >> time;
    }
    void cat() {
        interest = (principal * rate * time) / 100.0;
        cout << "Simple Interest: " << interest << endl;
    }
};

int main() {
    SimpleInterest n1; 
    n1.get();          
    n1.hold();         
    n1.Time();         
    n1.cat();          
    return 0;
}
