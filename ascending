void main(){
    int a[10],i,n,j,alex;
    printf("Enter the number==>");
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
    scanf("%d",&a[i]);
    }
    for(i=0;i<n-1;i++){
        for(j=0;j<n-1-i;j++){
            if(a[j]>a[j+1]){
                alex=a[j];
                a[j]=a[j+1];
                a[j+1]=alex;
            }
        }
    }
    printf("\nArray arranged Ascending order\n");
    for(i=0;i<n;i++)
    {
        printf("\n%d",a[i]);
        
    }
}
