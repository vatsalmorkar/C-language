#include <iostream>

using namespace std;

class A {
public:
    void max(int a, int b) {
        if (a > b) {
            cout << "Maximum: " << a << endl;
        } else {
            cout << "Maximum: " << b << endl;
        }
    }
};

int main() {
    A obj; 
    obj.max(500, 100);
    return 0;
}
