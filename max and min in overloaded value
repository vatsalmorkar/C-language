#include <iostream>
using namespace std;

// max for two ints
int max(int a, int b) {
    return (a > b) ? a : b;
}

// max for two doubles
double max(double a, double b) {
    return (a > b) ? a : b;
}

// max for three ints
int max(int a, int b, int c) {
    return max(max(a, b), c);
}

int main() {
    cout << max(5, 7) << endl;         // Output: 7
    cout << max(4.2, 2.8) << endl;     // Output: 4.2
    cout << max(3, 9, 2) << endl;      // Output: 9
    return 0;
}
