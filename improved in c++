 using namespace std;
int main() { 
string holderName; string accNo; double openingBalance = 0.0; double deposit = 0.0; double withdraw = 0.0;
 cout << "Enter Holder Name: ";
 getline(cin, holderName);
 cout << "Enter Account Number: ";
 getline(cin, accNo); 
cout << "Enter Opening Balance: ";
cin >> openingBalance;
 cout << "Enter Deposit Amount: ";
 cin >> deposit; 
cout << "Enter Withdraw Amount: ";
 cin >> withdraw;
 double finalBalance = openingBalance + deposit - withdraw;
 cout << "\nAccount Summary:\n"; 
cout << "Holder Name: " << holderName << endl;
 cout << "Account Number: " << accNo << endl; 
cout << "Opening Balance: " << openingBalance << endl;
 cout << "Deposit: " << deposit << endl;
 cout << "Withdraw: " << withdraw << endl;
 cout << "Final Balance: " << finalBalance << endl; 
return 0; }
